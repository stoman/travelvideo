{
  "name": "travelvideo",
  "version": "1.0.0",
  "private": true,
  "description": "Videos from our journeys. Details: travelvideo.stoman.de",
  "author": "Stefan Toman",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "test": "tsc --noEmit && node --test \"src/**/*.test.ts\""
  },
  "repository": "",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "license": "MIT",
  "dependencies": {
    "maplibre-gl": "^6.10.0"
  }
}
